{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
                {
            "name": "Launch Recommendations Daemon job",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-cli/main.go",
            "args": [
                "daemon",
                "trigger",
                "--daemons",
                "recommendations"
            ],
        },
        {
            "name": "Launch Daemon Pipeline",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-cli/main.go",
            "args": [
                "daemon",
                "trigger",
                "--daemons",
                "fixedVersions"
            ],
        },
        {
            "name": "Launch specific Daemon Pipeline",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-cli/main.go",
            "args": [
                "daemon",
                "runPipeline",
                "169319b7-8170-469f-9e31-f87b6054e507",
                "--assetVersionSlug",
                "main",
                "--dryRun=false"
            ],
        },
        {
            "name": "Launch Server",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard/main.go",
            "args": [],
        },
        {
            "name": "Launch DepTreeWalk",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-cli/test",
            "args": [],
        },
        {
            "name": "Launch Policy eval",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-scanner/main.go",
            "args": [
                "attestations",
                "registry.opencode.de/open-code/oci/coreutils:1.0.0-rc.3-minimal-amd64",
                "--policy",
                "container.gov.de.rego"
            ],
        },
        {
            "name": "Launch Server with Prod Database",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard/main.go",
            "args": [],
            "env": {
                "DISABLE_AUTOMIGRATE": "true",
                "POSTGRES_PORT": "5433"
            }
        },
        {
            "name": "VulnDB Export Diffs",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-cli/main.go",
            "args": [
                "vulndb",
                "export",
            ],
        },
        {
            "name": "VulnDB Sync",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-cli/main.go",
            "args": [
                "vulndb",
                "sync",
                "--databases",
                "epss"
            ]
        },
        {
            "name": "VulnDB Import",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-cli/main.go",
            "args": [
                "vulndb",
                "import"
            ]
        },
        {
            "name": "VulnDB Local Import",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-cli/main.go",
            "args": [
                "vulndb",
                "import",
                "--localArchive"
            ]
        },
                {
            "name": "Migrate",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-cli/main.go",
            "args": [
                "migrate"
            ]
        },
        {
            "name": "VulnDB ExportRC",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-cli/main.go",
            "args": [
                "vulndb",
                "export"
            ]
        },
        {
            "name": "Merge sboms",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "mode": "auto",
            "program": "${workspaceRoot}/cmd/devguard-scanner/main.go",
            "args": [
              "container-scanning", "result", "--sbomOutputPath=test.json",
            ]
        },
    ]
}